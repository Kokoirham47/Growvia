# =============================================================================
# GROWVIA — ENVIRONMENT VARIABLES (TEMPLATE)
# Salin file ini menjadi .env.local dan isi dengan token Anda
# =============================================================================

# Base URL Aplikasi
NEXT_PUBLIC_APP_URL=http://localhost:3000
BASEPATH=

# =============================================================================
# SUPABASE CONFIGURATION
# Dapatkan di dashboard Supabase: Project Settings -> API
# =============================================================================

# Project URL (contoh: https://xxxxxxxxxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Anon / Public Key (Aman digunakan di browser/client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Service Role Key (RAHASIA: Hanya untuk server-side/API route, bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# JWT Secret (Project Settings -> API -> JWT Secret)
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# =============================================================================
# AI PROVIDER (Gemini API untuk F04 Skill Extraction & F07 Learning Rec)
# =============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# =============================================================================
# DATABASE POSTGRESQL (OPSIONAL / JIKA PAKAI PRISMA ATAU DIRECT PG)
# Dapatkan di: Project Settings -> Database -> Connection String
# =============================================================================

# Connection Pooling (Transaction Mode - Port 6543)
DATABASE_URL=your_database_url_pooled

# Direct Connection (Session Mode - Port 5432)
DIRECT_URL=your_database_url_direct
